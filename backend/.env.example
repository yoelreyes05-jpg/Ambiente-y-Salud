# ── Supabase (MISMA base de datos que el resto de tus CRM, tablas asa_* aisladas) ──
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=coloca-aqui-la-service-role-key

# ── Autenticación ──
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# ── CORS (dominios permitidos, separados por coma) ──
# Incluye localhost para poder probar el panel-web/frontend en tu maquina
# mientras el backend corre en localhost:4000. Quita los localhost cuando
# publiques a produccion si quieres restringirlo solo a tus dominios reales.
CORS_ORIGINS=http://localhost:3000,http://localhost:4000,https://ambienteysalud.online,https://app.ambienteysalud.online

# ── WhatsApp Business API (recordatorios y notificaciones) ──
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# ── Proveedor de e-CF certificado (DGII / Ley 32-23) ──
ECF_PROVIDER_BASE_URL=
ECF_PROVIDER_API_KEY=

# ── Puerto ──
PORT=4000
